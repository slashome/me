  "dany-bill": {
    "kind": "person",
    "name": "Dany Bill",
    "sortName": "Bill, Dany",
    "born": "1973-04-28",
    "gender": "m",
    "bio": "Boxeur camerounais, sept fois champion du monde de muay-thaï. En 1993, il devient le premier combattant venu de France à décrocher un titre mondial en Thaïlande.",
    "nicknames": [
      {
        "lang": "fr",
        "text": "l'Extraterrestre du Muay Thaï",
        "note": "Forgé par le journaliste Pascal Iglicki dans Karaté Bushido, après le titre mondial de Bangkok en 1993 — Dany Bill le raconte lui-même. Circule aussi sous la variante « l'Extraterrestre des rings ».",
        "translations": [
          {
            "lang": "en",
            "text": "the Alien of Muay Thai"
          }
        ]
      },
      {
        "lang": "th",
        "text": "ไอ้ดำพระกาฬ",
        "note": "⚠️ Traduit « Black Monk » par Wikipédia anglophone (sans source), et repris partout. C'est très probablement un contresens : พระ est ici le préfixe honorifique des divinités, pas le mot « moine », et พระกาฬ (Phra Kan) désigne le seigneur de la Mort — Yama, du sanskrit Kāla. กาฬ vaut « noir » selon la Société royale de Thaïlande (cf. กาฬทวีป, « continent noir »). Sens plus fidèle : « le Noir de la Mort ». Aucune source thaïlandaise trouvée pour cette graphie : à confirmer par un locuteur thaï.",
        "translations": [
          {
            "lang": "fr",
            "text": "le Noir de la Mort"
          },
          {
            "lang": "en",
            "text": "the Black One of the Death God"
          }
        ]
      },
      {
        "lang": "th",
        "text": "สิงดำ อันตราย",
        "note": "สิงห์ = lion, ดำ = noir, อันตราย = dangereux. Siam Fight Mag translittère « Singdam Anetaraï » et traduit simplement « le Lion noir », en omettant le qualificatif. Graphie thaïe attestée seulement par des sources occidentales.",
        "translations": [
          {
            "lang": "fr",
            "text": "le Lion noir dangereux"
          },
          {
            "lang": "en",
            "text": "Dangerous Black Lion"
          }
        ]
      }
    ],
    "links": [
