---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['mark', className]}
  viewBox="0 0 64 64"
  width="30"
  height="30"
  role="img"
  aria-label="slashome"
>
  <circle class="mark__face" cx="32" cy="32" r="27" />
  <path class="mark__wire" d="M32 41q7 6 14 0" />
  <circle class="mark__lens" cx="21" cy="27" r="9.5" />
  <circle class="mark__lens" cx="43" cy="27" r="9.5" />
  <path class="mark__wire" d="M30.5 27h3" />
  <path class="mark__wire" d="M11.5 27q-4 -1 -6 -4" />
  <path class="mark__wire" d="M52.5 27q4 -1 6 -4" />
</svg>
