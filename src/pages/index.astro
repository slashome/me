---
import Base from '../layouts/Base.astro';
import '../styles/title.css';

/**
 * Le numéro de build est une vraie donnée, lue au build et jamais dans le
 * navigateur. Le `try` couvre le cas d'un build hors dépôt git.
 */
import { execSync } from 'node:child_process';
let build = 'dev';
try {
  build = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] })
    .toString()
    .trim();
} catch {
  /* pas de dépôt git : on garde « dev » */
}

/**
 * Deux groupes, comme chez Project Zomboid : ce qu'on consulte, puis ce qui
 * règle. Chemins en anglais, libellés en français.
 */
const MENU = [
  [
    { href: '/projects/', label: 'Projets' },
    { href: '/journal/', label: 'Journal' },
    { href: '/inventory/quotes/', label: 'Inventaire' },
    { href: '/agents/', label: 'Agents' },
  ],
  [
    { href: '/profile/', label: 'Profil' },
    { href: '/options/', label: 'Options' },
  ],
];
---

<Base
  variant="screen"
  title="slashome.me"
  description="Florian Boulestreau — ce que je construis, ce que j'écris, ce que je garde."
>
  <div class="title-screen">
    <div class="title-screen__decor" aria-hidden="true"></div>

    <div class="title-screen__inner">
      <h1 class="title-screen__brand">slashome</h1>

      <nav class="title-menu" aria-label="Menu principal">
        {
          MENU.map((groupe) => (
            <ul>
              {groupe.map(({ href, label }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          ))
        }
      </nav>

      <p class="title-screen__meta">
        <span>build {build}</span>
        <span>fr</span>
      </p>
    </div>
  </div>

  <div class="crt" aria-hidden="true"></div>
</Base>

<script>
  /**
   * Flèches haut/bas dans le menu, comme dans un jeu.
   *
   * Amélioration progressive stricte : sans ce script, Tab et Entrée
   * fonctionnent déjà — ce sont de vrais liens. Il n'ajoute qu'un raccourci.
   *
   * Pas d'autofocus au chargement : voler le focus à l'arrivée est hostile au
   * lecteur d'écran. La première flèche entre dans le menu, par le haut ou par
   * le bas selon la touche.
   */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.title-menu a'));

  if (links.length) {
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;

      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      event.preventDefault();

      const next =
        event.key === 'ArrowDown'
          ? (current + 1) % links.length
          : current <= 0
            ? links.length - 1
            : current - 1;

      links[next]?.focus();
    });
  }
</script>
