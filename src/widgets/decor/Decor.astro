---
import './decor.css';
import Character from './Character.astro';
import Alley from './scenes/Alley.astro';

export type DecorScene = 'veille' | 'alley';
export type DecorAnim = 'draw' | 'idle' | 'vibrate';

interface Props {
  scene?: DecorScene;
  anim?: DecorAnim;
}

const { scene = 'alley', anim = 'draw' } = Astro.props;
---

<div class="decor-scene" data-scene={scene} data-anim={anim} aria-hidden="true">
  {scene === 'alley' && <Alley />}
  <Character />
</div>
