---
import Character from '../Character.astro';
---

<svg
  class="alley"
  viewBox="0 0 1600 900"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="alley-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1a1512" />
      <stop offset="1" stop-color="#3a2a1c" />
    </linearGradient>
    <radialGradient id="alley-lamp" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="rgba(224,150,80,0.55)" />
      <stop offset="1" stop-color="rgba(224,150,80,0)" />
    </radialGradient>
  </defs>

  <rect class="alley__back" x="620" y="300" width="360" height="330" />

  <path class="alley__wall" d="M0 0 L620 300 L620 630 L0 900 Z" />
  <path class="alley__wall alley__wall--right" d="M1600 0 L980 300 L980 630 L1600 900 Z" />
  <path class="alley__ground" d="M0 900 L620 630 L980 630 L1600 900 Z" />

  <g class="alley__lines">
    <path d="M0 190 L620 372" />
    <path d="M0 400 L620 452" />
    <path d="M0 610 L620 532" />
    <path d="M1600 190 L980 372" />
    <path d="M1600 430 L980 462" />
  </g>

  <g class="alley__props">
    <rect x="120" y="250" width="120" height="150" rx="4" />
    <path d="M300 300 L300 560" />
    <path d="M292 300 h16" />
    <rect x="1180" y="300" width="150" height="190" rx="4" />
    <path d="M700 630 h200" />
  </g>

  <g class="alley__bin">
    <rect x="1010" y="520" width="130" height="110" rx="3" />
    <path class="alley__lid" d="M1002 520 h146" />
  </g>

  <circle class="alley__lamp" cx="620" cy="470" r="300" />
  <path class="alley__glow" d="M620 630 L980 630 L1120 900 L470 900 Z" />
</svg>

<Character />
