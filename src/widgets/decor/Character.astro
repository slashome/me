    <path class="ink" d="M84 262q-4 34 6 66"  pathLength="1" />
    <path class="ink" d="M136 262q4 34 -6 66"  pathLength="1" />

    <g class="figure__legs figure__legs--stand">
      <path class="ink" d="M92 328q-4 62 -2 118"  pathLength="1" />
