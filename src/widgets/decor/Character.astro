      <circle class="lens" cx="125" cy="92" r="12"  pathLength="1" />
      <path class="ink" d="M109 92h4"  pathLength="1" />

      <path class="ink" d="M100 118v14"  pathLength="1" />
      <path class="ink" d="M120 118v14"  pathLength="1" />

