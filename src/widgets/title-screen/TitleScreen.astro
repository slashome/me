---
import './title-screen.css';
import type { NavItem } from '../../shared/config/navigation';

interface Props {
  build: string;
  menu: NavItem[][];
}

const { build, menu } = Astro.props;
---

<div class="title-screen">
  <h1 class="title-screen__brand">slashome</h1>

  <nav class="title-menu" data-menu aria-label="Menu principal">
    {
      menu.map((groupe) => (
        <ul>
          {groupe.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      ))
    }
  </nav>

  <p class="title-screen__meta">
    <span>build {build}</span>
    <span>fr</span>
  </p>
</div>

