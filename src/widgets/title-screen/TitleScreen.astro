---
import './title-screen.css';

interface Props {
  build: string;
  menu: { href: string; label: string }[][];
}

const { build, menu } = Astro.props;
---

<div class="title-screen">
  <div class="title-screen__decor" aria-hidden="true"></div>

  <div class="title-screen__inner">
    <h1 class="title-screen__brand">slashome</h1>

    <nav class="title-menu" aria-label="Menu principal">
      {
        menu.map((groupe) => (
          <ul>
            {groupe.map(({ href, label }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        ))
      }
    </nav>

    <p class="title-screen__meta">
      <span>build {build}</span>
      <span>fr</span>
    </p>
  </div>
</div>

<div class="crt" aria-hidden="true"></div>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.title-menu a'));

  if (links.length) {
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;

      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      event.preventDefault();

      const next =
        event.key === 'ArrowDown'
          ? (current + 1) % links.length
          : current <= 0
            ? links.length - 1
            : current - 1;

      links[next]?.focus();
    });
  }
</script>
