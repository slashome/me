---
import './breadcrumb.css';
import Mark from '../../entities/brand/Mark.astro';

export interface Crumb {
  href?: string;
  label: string;
  lang?: string;
}

interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
---

{
  trail.length > 0 && (
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <ol>
        <li class="breadcrumb__home">
          <a href="/">
            <Mark />
          </a>
        </li>
        {trail.map(({ href, label, lang }, i) => (
          <li aria-current={i === trail.length - 1 ? 'page' : undefined}>
            {href && i < trail.length - 1 ? (
              <a href={href} lang={lang}>
                {label}
              </a>
            ) : (
              <span lang={lang}>{label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
