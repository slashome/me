---
import '../styles/global.css';
import '../styles/scene.css';
import '../styles/theme.css';
import '../styles/themes/existence.css';
import Breadcrumb, { type Crumb } from '../../widgets/breadcrumb/Breadcrumb.astro';
import Decor from '../../widgets/decor/Decor.astro';
import { DEFAULT_THEME, THEME_IDS, THEME_STORAGE_KEY } from '../../shared/config/themes';

interface Props {
  title: string;
  description: string;
  trail?: Crumb[];
  preloadTitleFont?: boolean;
}

const { title, description, trail = [], preloadTitleFont = false } = Astro.props;

const parent = trail.length > 1 ? trail[trail.length - 2]?.href : trail.length === 1 ? '/' : undefined;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const fullTitle = path === '/' ? title : `${title} — slashome.me`;
---

<html lang="fr" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      preloadTitleFont && (
        <link
          rel="preload"
          href="/fonts/special-elite-slashome.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Journal — slashome.me" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />

    {/* Résolution du thème avant le premier rendu : c'est ce qui évite le flash
        d'un thème sur l'autre. Sans JavaScript, le thème servi reste celui du
        HTML, et le site est complet. `?theme=<id>` bascule et persiste. */}
    <script is:inline define:vars={{ ids: THEME_IDS, storageKey: THEME_STORAGE_KEY }}>
      try {
        const asked = new URLSearchParams(window.location.search).get('theme');
        if (asked && ids.includes(asked)) localStorage.setItem(storageKey, asked);

        const chosen = localStorage.getItem(storageKey);
        if (chosen && ids.includes(chosen)) document.documentElement.dataset.theme = chosen;
      } catch {
        /* Stockage indisponible : le thème par défaut tient. */
      }
    </script>
  </head>

  <body class="scene" data-up={parent}>
    <div class="scene__decor" aria-hidden="true"></div>
    <Decor />
    <Breadcrumb trail={trail} />
    <main class="scene__main">
      <slot />
    </main>
    <div class="crt" aria-hidden="true"></div>

    <p class="hint" data-hint aria-hidden="true">
      <span data-hint-keys>WASD</span> déplacer · <span>◂</span> retour · <span>▸</span> valider
    </p>

    <script>
      import { bindKeyboard, layoutHint } from '../../shared/lib/keyboard';

      bindKeyboard();

      layoutHint().then((keys) => {
        const slot = document.querySelector('[data-hint-keys]');
        if (slot) slot.textContent = keys;
      });
    </script>
  </body>
</html>
